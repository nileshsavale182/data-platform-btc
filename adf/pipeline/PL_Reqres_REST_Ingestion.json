{
	"name": "PL_Reqres_REST_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "SP_Insert_Audit_Started",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": []
			},
			{
				"name": "Set_v_runStartTime",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "SP_Insert_Audit_Started",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_runStartTime",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_v_upperBound",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_v_runStartTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_upperBound",
					"value": ""
				}
			},
			{
				"name": "Set_v_lowerBound",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "SP_Insert_Audit_Started",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_lowerBound",
					"value": ""
				}
			},
			{
				"name": "Set_v_PageSize",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "SP_Insert_Audit_Started",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_pageSize",
					"value": 100
				}
			},
			{
				"name": "Set_v_currentPage",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "SP_Insert_Audit_Started",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_currentPage",
					"value": 1
				}
			},
			{
				"name": "Copy_GetFirstPage",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set_v_upperBound",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_v_lowerBound",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_v_PageSize",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_v_currentPage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"enableStaging": false
				}
			},
			{
				"name": "Lookup_totalCount",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Copy_GetFirstPage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "Json1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set_v_totalCount",
				"description": "",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Lookup_totalCount",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_totalCount",
					"value": ""
				}
			},
			{
				"name": "Until_LastPage",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "Set_v_totalPages",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(variables('v_currentPage'), variables('v_pageSize'))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_REST_Demo",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "Json1",
									"type": "DatasetReference",
									"parameters": {
										"p_currentPage": {
											"value": "@concat(\n    'page_',\n    variables('v_currentPage'),\n    '.json'\n)",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Set_v_currentPageTemp",
							"description": "As self referencing of variable is not allowed in ADF we are setting temporary value to v_currentPageTemp and then we will again set that value to v_currentPage",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_v_pagesProcessed",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_currentPage_Temp",
								"value": {
									"value": "@add(variables('v_currentPage'), 1)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_v_currentPage_Increment",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_v_currentPageTemp",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_currentPage",
								"value": {
									"value": "@variables('v_currentPage_Temp')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_v_pagesProcessed",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set_v_pagesProcessedTemp",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_pagesProcessed",
								"value": {
									"value": "@variables('v_pagesProcessedTemp')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_v_pagesProcessedTemp",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy data1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_pagesProcessedTemp",
								"value": {
									"value": "@add(variables('v_pagesProcessed'), 1)",
									"type": "Expression"
								}
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "Set_v_totalPages",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_v_totalCount",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_totalPages",
					"value": {
						"value": "@div(\n    add(variables('v_totalCount'), \n        sub(variables('v_pageSize'), 1)    \n        ), \n    variables('v_pageSize')\n    )",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Reconciliation_Pages_Processed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Until_LastPage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_pagesProcessed'), variables('v_totalPages'))",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "SP_Update_Audit_FAILED",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Transformation",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "@masterPipeline.parameter().notebook_path",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SP_Update_Audit_SUCCESS",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Transformation",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Update_State",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "SP_Update_Audit_SUCCESS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"variables": {
			"v_runId": {
				"type": "String"
			},
			"v_entityName": {
				"type": "String"
			},
			"v_environment": {
				"type": "String"
			},
			"v_lastWatermark": {
				"type": "String"
			},
			"v_runStartTime": {
				"type": "String"
			},
			"v_lowerBound": {
				"type": "Integer"
			},
			"v_upperBound": {
				"type": "Integer"
			},
			"v_pageSize": {
				"type": "Integer"
			},
			"v_currentPage": {
				"type": "Integer"
			},
			"v_totalCount": {
				"type": "Integer"
			},
			"v_totalPages": {
				"type": "Integer"
			},
			"v_pagesProcessed": {
				"type": "Integer"
			},
			"v_recordsExpected": {
				"type": "Integer"
			},
			"v_recordsWrittenRaw": {
				"type": "Integer"
			},
			"v_errorMessage": {
				"type": "String"
			},
			"v_apiResponseStatus": {
				"type": "String"
			},
			"v_retryCount": {
				"type": "Integer"
			},
			"v_executionStartTime": {
				"type": "String"
			},
			"v_currentPage_Temp": {
				"type": "Integer"
			},
			"v_pagesProcessedTemp": {
				"type": "Integer"
			}
		},
		"annotations": []
	}
}