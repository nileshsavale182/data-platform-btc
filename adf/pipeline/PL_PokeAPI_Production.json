{
	"name": "PL_PokeAPI_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "UntilLastPage",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_hasMore'), false)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_Pokemon",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_REST_Pokemon",
									"type": "DatasetReference",
									"parameters": {
										"offset": {
											"value": "@string(variables('v_offset'))",
											"type": "Expression"
										},
										"limit": {
											"value": "@string(variables('v_limit'))",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Pokemon_Raw",
									"type": "DatasetReference",
									"parameters": {
										"p_filename": {
											"value": "@concat('Pokemon_offset_',variables('v_offset'),utcNow(),'.json')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "If Condition",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Copy_Pokemon",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('Copy_Pokemon').output.rowsCopied, 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Set variable1",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_offsetNew",
											"value": {
												"value": "@add(variables('v_offset'), variables('v_limit'))",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Set variable2",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "Set variable1",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_offset",
											"value": {
												"value": "@variables('v_offsetNew')",
												"type": "Expression"
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Set variable",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_hasMore",
											"value": false
										}
									}
								]
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			}
		],
		"variables": {
			"v_offset": {
				"type": "Integer",
				"defaultValue": 0
			},
			"v_limit": {
				"type": "Integer",
				"defaultValue": 20
			},
			"v_hasMore": {
				"type": "Boolean",
				"defaultValue": true
			},
			"v_offsetNew": {
				"type": "Integer",
				"defaultValue": 0
			}
		},
		"annotations": []
	}
}